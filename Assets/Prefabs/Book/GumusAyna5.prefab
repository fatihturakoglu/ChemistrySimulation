  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tollens Ay\u0131rac\u0131 Haz\u0131rlama: Deney t\xFCp\xFCne g\xFCm\xFC\u015F
    nitrat koyun ve \xFCzerine bulan\u0131kl\u0131k gidene kadar damla damla amonyak
    ekleyin.\u015Eeker Ekleme: Haz\u0131rlanan bu \u015Feffaf kar\u0131\u015F\u0131ma
    bir miktar glikoz \xE7\xF6zeltisi ilave edin.Is\u0131tma: Deney t\xFCp\xFCn\xFC
    do\u011Frudan ate\u015Fe tutmak yerine, i\xE7inde s\u0131cak su bulunan bir beherin
    (su banyosu) i\xE7ine yerle\u015Ftirin.\nG\xF6zlem: Birka\xE7 dakika bekledi\u011Finizde,
    t\xFCp\xFCn i\xE7 y\xFCzeyinin \xF6nce kahverengile\u015Fti\u011Fini, ard\u0131ndan
    saf bir g\xFCm\xFC\u015F ayna ile kapland\u0131\u011F\u0131n\u0131 g\xF6receksiniz."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
